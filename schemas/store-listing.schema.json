{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gamekit/store-listing.schema.json",
  "title": "store/listing.yaml — tên, mô tả, cách chơi, tag của game trên portal, mỗi ngôn ngữ một bản",
  "type": "object",
  "required": ["title", "description", "controls", "tags"],
  "additionalProperties": false,
  "definitions": {
    "text": {
      "type": "object",
      "required": ["en"],
      "propertyNames": { "pattern": "^[a-z]{2,3}(-[a-z0-9]{2,8})*$" },
      "additionalProperties": { "type": "string" }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "title": { "$ref": "#/definitions/text" },
    "short": { "$ref": "#/definitions/text", "description": "Một câu giới thiệu" },
    "description": { "$ref": "#/definitions/text" },
    "controls": { "$ref": "#/definitions/text", "description": "Cách điều khiển trên máy tính và điện thoại" },
    "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9 -]*$" }, "uniqueItems": true },
    "categories": { "type": "array", "items": { "type": "string" } }
  }
}
