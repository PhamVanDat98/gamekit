{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gamekit/oracle.schema.json",
  "title": "spec/oracles/*.json — bảng đầu vào → kết quả lấy từ game gốc, để test parity lặp qua",
  "type": "object",
  "required": ["source", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "source": { "type": "string", "minLength": 1, "description": "Lấy từ đâu trong game gốc: file + hàm/offset, bảng data, hoặc đo từ video" },
    "confidence": { "enum": ["observed", "derived", "inferred"] },
    "evidence": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^ev_[0-9a-f]{64}$" }, "description": "Evidence id của REA (ev_…) đã cho ra bảng này; phải có trong notes/re-log.jsonl" },
    "description": { "type": "string" },
    "tolerance": { "type": "number", "minimum": 0, "description": "Sai số tương đối mặc định cho mọi case" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["in", "out"],
        "additionalProperties": false,
        "properties": {
          "in": { "description": "Đầu vào" },
          "out": { "description": "Kết quả của game gốc" },
          "tolerance": { "type": "number", "minimum": 0 },
          "note": { "type": "string" }
        }
      }
    }
  }
}
