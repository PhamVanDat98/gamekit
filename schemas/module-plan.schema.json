{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gamekit/module-plan.schema.json",
  "title": "module-plan.yaml — chia module để dựng song song",
  "type": "object",
  "required": ["base", "shared", "modules"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "build", "description": "Mặc định: dựng lại (P2). Phân tích (P1) dùng re-plan.yaml" },
    "base": { "type": "string", "description": "Nhánh gốc, thường là main" },
    "shared": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Đường dẫn chỉ agent chính được sửa (contracts/, params/, package.json…)"
    },
    "maxParallel": { "type": "integer", "minimum": 1, "maximum": 8 },
    "links": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Thư mục local đã gitignore (decompiled/, reference/…) được symlink vào worktree của từng module"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "wave", "owns", "brief"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "wave": { "type": "integer", "minimum": 1 },
          "owns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "brief": { "type": "string", "minLength": 1, "description": "Việc cần làm, trích spec liên quan" },
          "contracts": { "type": "array", "items": { "type": "string" }, "description": "File contract module này dùng" },
          "tests": { "type": "array", "items": { "type": "string" }, "description": "Đường dẫn test phải xanh" }
        }
      }
    }
  }
}
