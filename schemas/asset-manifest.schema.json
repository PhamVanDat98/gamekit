{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gamekit/asset-manifest.schema.json",
  "title": "asset-manifest.json — spec kỹ thuật từng asset (asset-spec, P3)",
  "type": "object",
  "required": ["assets"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "kind"],
        "additionalProperties": false,
        "if": { "properties": { "kind": { "not": { "const": "audio" } } } },
        "then": { "required": ["width", "height"] },
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "description": "Chữ thường, số, . _ -" },
          "path": { "type": "string", "pattern": "^(?!.*(^|/)\\.\\.?(/|$))(assets|public)/[^\\\\:*?\"<>|]+$", "description": "File @1x, đường dẫn từ gốc game trong assets/ hoặc public/, dùng /" },
          "kind": { "enum": ["sprite", "ui", "anim", "background", "tile", "icon", "texture", "model", "audio"] },
          "make": { "enum": ["vector", "image-gen", "own", "licensed"], "description": "UI nên là vector (SVG/CSS)" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "scales": { "type": "array", "items": { "type": "number" } },
          "alpha": { "type": "boolean" },
          "pivot": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "padding": { "type": "integer", "minimum": 0 },
          "atlas": { "type": "string" },
          "nineSlice": { "type": "array", "items": { "type": "integer" }, "minItems": 4, "maxItems": 4, "description": "left, top, right, bottom" },
          "states": { "type": "array", "items": { "type": "string" } },
          "frames": {
            "type": "object",
            "required": ["count", "width", "height", "fps"],
            "properties": {
              "count": { "type": "integer", "minimum": 1 },
              "width": { "type": "integer" },
              "height": { "type": "integer" },
              "fps": { "type": "number" }
            }
          },
          "seamless": { "type": "boolean" },
          "collider": { "type": "string", "description": "Đường dẫn param collider, vd player.hitbox" },
          "minDisplayPx": { "type": "integer", "description": "Kích thước nhỏ nhất thật sự hiển thị (icon)" },
          "noText": { "type": "boolean", "description": "Không in chữ vào ảnh" },
          "text": { "type": "boolean", "description": "Ảnh có chữ (logo, nút, banner…): path phải ở assets/i18n/en/, mỗi ngôn ngữ một bản cùng đường dẫn trong assets/i18n/<mã>/" },
          "textKey": { "type": "string", "description": "Key trong Language/*.json: chữ in trong ảnh (text: true) hoặc lời thoại (voice: true)" },
          "voice": { "type": "boolean", "description": "Lời thoại đọc từ textKey (gamekit gen voice), mỗi ngôn ngữ một file trong assets/i18n/<mã>/" },
          "ref": { "type": "string", "description": "File tham chiếu: asset gốc trong reference/ mà asset này thay thế (third-party), hoặc file gốc đã xuất (own)" },
          "prompt": { "type": "string", "description": "Thêm vào prompt khi sinh (gamekit gen); brief vẫn là mô tả chính" },
          "gen": {
            "type": "object",
            "description": "Lần sinh gần nhất (gamekit gen ghi)",
            "properties": { "model": { "type": "string" }, "at": { "type": "string" }, "prompt": { "type": "string" }, "langs": { "type": "array", "items": { "type": "string" } } }
          },
          "review": {
            "type": "object",
            "required": ["status"],
            "additionalProperties": false,
            "description": "Kết quả duyệt (gamekit review --apply)",
            "properties": { "status": { "enum": ["ok", "fix"] }, "note": { "type": ["string", "null"] }, "at": { "type": ["string", "null"] } }
          },
          "brief": { "type": "string" }
        }
      }
    }
  }
}
