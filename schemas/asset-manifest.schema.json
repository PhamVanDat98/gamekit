{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gamekit/asset-manifest.schema.json",
  "title": "asset-manifest.json — spec kỹ thuật từng asset (asset-spec, P3)",
  "type": "object",
  "required": ["assets"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "kind", "width", "height"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string", "description": "File @1x" },
          "kind": { "enum": ["sprite", "ui", "anim", "background", "tile", "icon", "texture", "model", "audio"] },
          "make": { "enum": ["vector", "pixel-code", "voxel-code", "image-gen", "own", "licensed"], "description": "image-gen: Codex image_gen (không API key); pixel-code: pixel art viết bằng code (pxl); voxel-code: voxel viết bằng code (voxel-art); vector: UI CSS/SVG" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "scales": { "type": "array", "items": { "type": "number" } },
          "alpha": { "type": "boolean" },
          "pivot": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "padding": { "type": "integer", "minimum": 0 },
          "atlas": { "type": "string" },
          "nineSlice": { "type": "array", "items": { "type": "integer" }, "minItems": 4, "maxItems": 4, "description": "left, top, right, bottom" },
          "states": { "type": "array", "items": { "type": "string" } },
          "frames": {
            "type": "object",
            "required": ["count", "width", "height", "fps"],
            "properties": {
              "count": { "type": "integer", "minimum": 1 },
              "width": { "type": "integer" },
              "height": { "type": "integer" },
              "fps": { "type": "number" }
            }
          },
          "seamless": { "type": "boolean" },
          "collider": { "type": "string", "description": "Đường dẫn param collider, vd player.hitbox" },
          "minDisplayPx": { "type": "integer", "description": "Kích thước nhỏ nhất thật sự hiển thị (icon)" },
          "noText": { "type": "boolean", "description": "Không in chữ vào ảnh" },
          "brief": { "type": "string" }
        }
      }
    }
  }
}
